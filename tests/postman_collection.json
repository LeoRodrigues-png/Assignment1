{
  "info": {
    "_postman_id": "b31e2c2b-2e68-4dfe-9a9f-7d2b6d6d8f01",
    "name": "Assignment1 Inventory API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/getAll",
          "host": ["{{baseUrl}}"],
          "path": ["getAll"]
        }
      }
    },
    {
      "name": "Get Single Product",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/getSingleProduct?product_id=1001",
          "host": ["{{baseUrl}}"],
          "path": ["getSingleProduct"],
          "query": [{ "key": "product_id", "value": "1001" }]
        }
      }
    },
    {
      "name": "Starts With (S)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/startsWith?letter=S",
          "host": ["{{baseUrl}}"],
          "path": ["startsWith"],
          "query": [{ "key": "letter", "value": "S" }]
        }
      }
    },
    {
      "name": "Paginate (1001-1010 limit 10)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/paginate?start_id=1001&end_id=1010",
          "host": ["{{baseUrl}}"],
          "path": ["paginate"],
          "query": [
            { "key": "start_id", "value": "1001" },
            { "key": "end_id", "value": "1010" }
          ]
        }
      }
    },
    {
      "name": "Convert to EUR",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/convert?product_id=1001",
          "host": ["{{baseUrl}}"],
          "path": ["convert"],
          "query": [{ "key": "product_id", "value": "1001" }]
        }
      }
    },
    {
      "name": "Add New Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 9999,\n  \"name\": \"Test Product\",\n  \"unit_price\": 12.34,\n  \"stock_quantity\": 5,\n  \"description\": \"Created by Newman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/addNew",
          "host": ["{{baseUrl}}"],
          "path": ["addNew"]
        }
      }
    },
    {
      "name": "Delete Product (9999)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/deleteOne?product_id=9999",
          "host": ["{{baseUrl}}"],
          "path": ["deleteOne"],
          "query": [{ "key": "product_id", "value": "9999" }]
        }
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000" }]
}

